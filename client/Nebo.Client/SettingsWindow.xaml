<Window x:Class="Nebo.Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:srs="clr-namespace:Nebo.Client.Srs"
        Title="Settings" Width="620" Height="640" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Nebo.Panel}" Foreground="{DynamicResource Nebo.Text}">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="80" Click="Close_Click"/>
        </StackPanel>
        <TabControl x:Name="Tabs">
            <TabItem Header="General">
                <StackPanel Margin="10">
                    <GroupBox Header="Theme" Padding="6">
                        <StackPanel>
                            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="System (follow Windows)" Tag="System" Checked="Theme_Checked"/>
                            <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Tag="Dark" Checked="Theme_Checked"/>
                            <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Tag="Light" Checked="Theme_Checked"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Map data" Padding="6" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="DcsPathText" TextWrapping="Wrap" Foreground="{DynamicResource Nebo.TextDim}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="DCS World folder…" Padding="8,1" Click="DcsFolder_Click"
                                        ToolTip="Where DCS World is installed (DCS Map, Charts, Satellite and airfield details are read from it)"/>
                                <Button Content="Airfield diagrams for this theatre…" Padding="8,1" Margin="8,0,0,0" Click="Diagrams_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Labels" Padding="6" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Show full labels of all contacts within" VerticalAlignment="Center"/>
                            <TextBox x:Name="HoverNmBox" Width="48" Margin="6,0,4,0" VerticalContentAlignment="Center"
                                     LostFocus="HoverNm_LostFocus" KeyDown="HoverNm_KeyDown" ToolTip="Nautical miles on the map; Enter applies"/>
                            <TextBlock Text="NM of the mouse" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Updates" Padding="6" Margin="0,8,0,0">
                        <CheckBox x:Name="UpdatesBox" Content="Tell me when a new NEBO version is out (asks GitHub once a day)" Click="Updates_Click"/>
                    </GroupBox>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Nebo.TextDim}"
                               Text="Each map's own options (base map, labels, label position, threat rings…) are on its toolbar."/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Keys">
                <StackPanel Margin="10">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Keys and mouse buttons for bullseye, RWR, NCTR, point info, the ruler, the launch jump and the DTC switch. Keys 1–8 jump to the engagement line with that marker."/>
                    <Button Content="Key bindings…" HorizontalAlignment="Left" Padding="8,1" Click="KeyBindings_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Alerts">
                <StackPanel Margin="10">
                    <GroupBox Header="Launch alarm (an enemy missile at one of your players)" Padding="6">
                        <StackPanel>
                            <CheckBox x:Name="AlarmSound" Content="Sound (the banner and the ring always show)" Click="AlarmSound_Click"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Volume" Width="110" VerticalAlignment="Center"/>
                                <RadioButton x:Name="AlarmQuiet" GroupName="Volume" Content="Quiet" Tag="0.2" Margin="0,0,10,0" Checked="AlarmVolume_Checked"/>
                                <RadioButton x:Name="AlarmNormal" GroupName="Volume" Content="Normal" Tag="0.5" Margin="0,0,10,0" Checked="AlarmVolume_Checked"/>
                                <RadioButton x:Name="AlarmLoud" GroupName="Volume" Content="Loud" Tag="1" Checked="AlarmVolume_Checked"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Alarms per launch" Width="110" VerticalAlignment="Center"/>
                                <RadioButton x:Name="AlarmOnce" GroupName="Repeats" Content="1" Tag="1" Margin="0,0,10,0" Checked="AlarmRepeats_Checked"/>
                                <RadioButton x:Name="AlarmTwice" GroupName="Repeats" Content="2" Tag="2" Margin="0,0,10,0" Checked="AlarmRepeats_Checked"/>
                                <RadioButton x:Name="AlarmThrice" GroupName="Repeats" Content="3" Tag="3" Checked="AlarmRepeats_Checked"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Test launch alarm" Padding="8,1" Click="AlarmTest_Click"/>
                                <CheckBox x:Name="AlarmAi" Content="For AI aircraft too (testing; off at the next start)" Margin="12,0,0,0"
                                          VerticalAlignment="Center" Click="AlarmAi_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Engagement alert (a line closes to its Alert NM)" Padding="6" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Three short ticks at half the launch alarm's volume." VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="Test" Padding="8,1" Click="EngagementTest_Click"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="SrsTab" Header="SRS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Your radio position (SRS range and line of sight)" Padding="6">
                            <srs:RadioPositionView/>
                        </GroupBox>
                        <GroupBox Header="SRS app" Padding="6" Margin="0,8,0,0">
                            <StackPanel>
                                <CheckBox x:Name="StartClientBox" Content="Start the SRS app on connecting to a NEBO server" Click="StartClient_Click"/>
                                <CheckBox x:Name="AutoEamBox" Content="Connect the SRS app in External AWACS Mode automatically" Margin="0,4,0,0" Click="AutoEam_Click"
                                          ToolTip="On connecting to a NEBO server, NEBO fills in the SRS app's server address and EAM password and clicks its buttons"/>
                                <TextBlock x:Name="SrsStatusText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Nebo.TextDim}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
