<!-- Tactical console, light: pale steel panels, teal accent. The same keys as Colors.Dark.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Nebo.Bg" Color="#D9E0E7"/>
    <SolidColorBrush x:Key="Nebo.Panel" Color="#EDF1F4"/>
    <SolidColorBrush x:Key="Nebo.PanelAlt" Color="#F8FAFB"/>
    <SolidColorBrush x:Key="Nebo.Control" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Nebo.Border" Color="#C3CDD6"/>
    <SolidColorBrush x:Key="Nebo.BorderStrong" Color="#97A6B4"/>
    <SolidColorBrush x:Key="Nebo.Text" Color="#14202B"/>
    <SolidColorBrush x:Key="Nebo.TextDim" Color="#55687A"/>
    <SolidColorBrush x:Key="Nebo.TextDisabled" Color="#9AA7B3"/>
    <SolidColorBrush x:Key="Nebo.Accent" Color="#007C91"/>
    <SolidColorBrush x:Key="Nebo.AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Nebo.AccentSoft" Color="#CDE7EC"/>
    <SolidColorBrush x:Key="Nebo.Hover" Color="#E0E7ED"/>
    <SolidColorBrush x:Key="Nebo.Pressed" Color="#D2DBE3"/>
    <SolidColorBrush x:Key="Nebo.Warn" Color="#A65F00"/>
    <SolidColorBrush x:Key="Nebo.Danger" Color="#C62828"/>
    <SolidColorBrush x:Key="Nebo.Good" Color="#1E7E34"/>
    <SolidColorBrush x:Key="Nebo.Friendly" Color="#1E5FC0"/>
    <SolidColorBrush x:Key="Nebo.Hostile" Color="#C62828"/>
    <SolidColorBrush x:Key="Nebo.Unknown" Color="#8A6D00"/>
    <SolidColorBrush x:Key="Nebo.Neutral" Color="#56636F"/>
</ResourceDictionary>
