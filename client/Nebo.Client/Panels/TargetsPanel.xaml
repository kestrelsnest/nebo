<UserControl x:Class="Nebo.Client.Panels.TargetsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
            <CheckBox x:Name="DoneBox" Content="Done zones" IsChecked="True" Margin="2,0,8,0" Click="Filter_Click"
                      ToolTip="Show zones whose targets are already destroyed"/>
            <CheckBox x:Name="UnassignedBox" Content="Unassigned" IsChecked="True" Margin="0,0,8,0" Click="Filter_Click"
                      ToolTip="Show target zones given to no flight"/>
        </ToolBar>
        <TextBlock DockPanel.Dock="Bottom" x:Name="SummaryText" Margin="6,3"/>
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="12" TextWrapping="Wrap" Foreground="{DynamicResource Nebo.TextDim}"
                   Text="No target zones. They appear here when the server runs a training mission with EventTargets (zones prepared by the Kneeboard Generator) and your side attacks them."/>
        <Grid x:Name="Body">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="ZoneGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                      SelectionChanged="ZoneGrid_SelectionChanged" MouseDoubleClick="ZoneGrid_MouseDoubleClick">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="Bold" Margin="4,6,0,2" Text="{Binding Name}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{Binding Brush}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Order}"/>
                    <DataGridTextColumn Header="Zone" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Destroyed" Binding="{Binding Progress}"/>
                    <DataGridTextColumn Header="Damaged" Binding="{Binding Damaged}"/>
                    <DataGridTextColumn Header="Targets" Binding="{Binding Count}"/>
                    <DataGridTextColumn Header="Kind" Binding="{Binding What}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>
            <DataGrid x:Name="ItemGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{Binding Brush}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Target" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}"/>
                    <DataGridTextColumn Header="Destroyed at" Binding="{Binding When}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
