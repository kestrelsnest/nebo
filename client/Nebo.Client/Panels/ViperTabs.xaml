<UserControl x:Class="Nebo.Client.Panels.ViperTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
        <!-- Steerpoints and routes -->
        <TabItem Header="STPT">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▲" Width="28" Click="Up_Click" ToolTip="Move the selected steerpoint up (renumbers)"/>
                        <Button Content="▼" Width="28" Margin="4,0,0,0" Click="Down_Click" ToolTip="Move the selected steerpoint down (renumbers)"/>
                        <Button Content="Delete" Padding="8,1" Margin="10,0,0,0" Click="Delete_Click"
                                ToolTip="Delete the selected steerpoints (Delete key); the ones after move up a number"/>
                        <CheckBox x:Name="MirrorBox" Content="Use the mission's steerpoints instead" VerticalAlignment="Center" Margin="14,0,0,0"
                                  Click="Mirror_Click"
                                  ToolTip="DCS's 'mirror' option: the jet loads the mission's waypoints and routes, not these. Editing a steerpoint turns it off."/>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource Nebo.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Right-click the map to add a steerpoint (25 at most); drag to move. Ctrl/Shift picks several. A route flies its steerpoints in number order."/>
                </StackPanel>
                <!-- The selected steerpoint -->
                <Grid x:Name="Editor" DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="EditorTitle" Grid.ColumnSpan="2" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Text="Type, note" VerticalAlignment="Center" Margin="0,0,8,3"/>
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,3">
                        <ComboBox x:Name="TypeBox" Width="64" SelectionChanged="Field_Changed"/>
                        <TextBox x:Name="NoteBox" Margin="6,0,0,0" LostFocus="Field_LostFocus"/>
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="Elevation" VerticalAlignment="Center" Margin="0,0,8,3"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBox x:Name="ElevBox" Width="70" LostFocus="Field_LostFocus" ToolTip="Ground elevation of the steerpoint, feet"/>
                        <TextBlock Text="ft" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Route altitude" VerticalAlignment="Center" Margin="0,0,8,3"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBox x:Name="AltBox" Width="70" LostFocus="Field_LostFocus"/>
                        <TextBlock Text="ft" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        <ComboBox x:Name="AltTypeBox" Width="60" SelectionChanged="Field_Changed"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="Speed" VerticalAlignment="Center" Margin="0,0,8,3"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBox x:Name="SpeedBox" Width="70" LostFocus="Field_LostFocus"/>
                        <TextBlock Text="kt" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        <ComboBox x:Name="SpeedTypeBox" Width="60" SelectionChanged="Field_Changed"/>
                    </StackPanel>
                    <TextBlock Grid.Row="5" Text="Time over" VerticalAlignment="Center" Margin="0,0,8,3"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBox x:Name="TosBox" Width="70" LostFocus="Field_LostFocus" ToolTip="hh:mm:ss of the mission day; empty: none"/>
                        <CheckBox x:Name="FixBox" Content="Fixed" VerticalAlignment="Center" Margin="8,0,0,0" Click="Field_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="6" Text="Routes" VerticalAlignment="Center" Margin="0,0,8,3"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                        <CheckBox x:Name="R1Box" Content="1" Margin="0,0,10,0" Click="Route_Click" Tag="1"/>
                        <CheckBox x:Name="R2Box" Content="2" Margin="0,0,10,0" Click="Route_Click" Tag="2"/>
                        <CheckBox x:Name="R3Box" Content="3" Click="Route_Click" Tag="3"/>
                    </StackPanel>
                    <TextBlock Grid.Row="7" Text="Offset aimpoints" VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <StackPanel Grid.Row="7" Grid.Column="1">
                        <DockPanel Margin="0,0,0,2">
                            <Button x:Name="Oa1Place" Content="Place OA1" Padding="6,0" Tag="1" Click="OapPlace_Click"
                                    ToolTip="The next right-click on the map places offset aimpoint 1"/>
                            <Button Content="Clear" Padding="6,0" Margin="4,0,0,0" Tag="1" Click="OapClear_Click"/>
                            <TextBlock x:Name="Oa1Text" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Nebo.TextDim}"/>
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="Oa2Place" Content="Place OA2" Padding="6,0" Tag="2" Click="OapPlace_Click"/>
                            <Button Content="Clear" Padding="6,0" Margin="4,0,0,0" Tag="2" Click="OapClear_Click"/>
                            <TextBlock x:Name="Oa2Text" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Nebo.TextDim}"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="StptList" FontFamily="Consolas" SelectionMode="Extended"
                         SelectionChanged="StptList_SelectionChanged" KeyDown="StptList_KeyDown"/>
            </DockPanel>
        </TabItem>

        <!-- Destination points (GPS mode of the session) -->
        <TabItem Header="DEST">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Delete" Padding="8,1" Click="Delete_Click" ToolTip="Delete the selected DEST points (Delete key)"/>
                        <CheckBox x:Name="DestMirror" Content="Use the mission's DEST points instead" VerticalAlignment="Center" Margin="14,0,0,0"
                                  Click="ListMirror_Click" Tag="DEST"/>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource Nebo.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Right-click the map to add a DEST point (19 at most, steerpoints 81–99 in the jet); drag to move."/>
                </StackPanel>
                <Grid x:Name="DestEditor" DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock x:Name="DestTitle" Grid.ColumnSpan="2" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="Text, note" VerticalAlignment="Center" Margin="0,0,8,3"/>
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,3">
                        <TextBox x:Name="DestText" Width="50" LostFocus="Dest_LostFocus" ToolTip="3 letters or digits"/>
                        <TextBox x:Name="DestNote" Margin="6,0,0,0" LostFocus="Dest_LostFocus" ToolTip="30 characters"/>
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="Elevation" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="DestElev" Width="70" LostFocus="Dest_LostFocus"/>
                        <TextBlock Text="ft" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="DestList" FontFamily="Consolas" SelectionMode="Extended"
                         SelectionChanged="DestList_SelectionChanged" KeyDown="StptList_KeyDown"/>
            </DockPanel>
        </TabItem>

        <!-- Preplanned threats (SA mode, threat rings) -->
        <TabItem Header="THREAT">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <DockPanel>
                        <TextBlock Text="New threats" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button DockPanel.Dock="Right" Content="Delete" Padding="8,1" Margin="6,0,0,0" Click="Delete_Click"
                                ToolTip="Delete the selected threats (Delete key)"/>
                        <ComboBox x:Name="NewThreatType" SelectionChanged="NewThreatType_Changed"
                                  ToolTip="The threat a right-click on the map places"/>
                    </DockPanel>
                    <CheckBox x:Name="ThreatMirror" Content="Use the mission's threats instead" Margin="0,4,0,0" Click="ListMirror_Click" Tag="THREAT_PTS"/>
                    <TextBlock Foreground="{DynamicResource Nebo.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Right-click the map to add a threat (15 at most, steerpoints 56–70); drag to move."/>
                </StackPanel>
                <Grid x:Name="ThreatEditor" DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock x:Name="ThreatTitle" Grid.ColumnSpan="2" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="Threat" VerticalAlignment="Center" Margin="0,0,8,3"/>
                    <ComboBox x:Name="ThreatType" Grid.Row="1" Grid.Column="1" Margin="0,0,0,3" SelectionChanged="ThreatType_Changed"/>
                    <TextBlock Grid.Row="2" Text="Text, ring" VerticalAlignment="Center" Margin="0,0,8,3"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBox x:Name="ThreatText" Width="50" LostFocus="Threat_LostFocus" ToolTip="3 letters or digits"/>
                        <CheckBox x:Name="ThreatRing" Content="Ring shown" VerticalAlignment="Center" Margin="10,0,0,0" Click="Threat_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Radius, altitude" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="ThreatRadius" Width="60" LostFocus="Threat_LostFocus" ToolTip="Custom threats only"/>
                        <TextBlock Text="NM" VerticalAlignment="Center" Margin="4,0,10,0"/>
                        <TextBox x:Name="ThreatAlt" Width="60" LostFocus="Threat_LostFocus" ToolTip="Custom threats only"/>
                        <TextBlock Text="ft" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="ThreatList" FontFamily="Consolas" SelectionMode="Extended"
                         SelectionChanged="ThreatList_SelectionChanged" KeyDown="StptList_KeyDown"/>
            </DockPanel>
        </TabItem>

        <!-- Geographic lines (SA mode, lines) -->
        <TabItem Header="GEO">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Current line" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <RadioButton x:Name="Geo1" Content="1" Margin="0,0,8,0" VerticalAlignment="Center" Tag="0" Click="GeoLine_Click"/>
                        <RadioButton x:Name="Geo2" Content="2" Margin="0,0,8,0" VerticalAlignment="Center" Tag="1" Click="GeoLine_Click"/>
                        <RadioButton x:Name="Geo3" Content="3" Margin="0,0,8,0" VerticalAlignment="Center" Tag="2" Click="GeoLine_Click"/>
                        <RadioButton x:Name="Geo4" Content="4" Margin="0,0,14,0" VerticalAlignment="Center" Tag="3" Click="GeoLine_Click"/>
                        <Button Content="Delete" Padding="8,1" Click="Delete_Click" ToolTip="Delete the selected points (Delete key)"/>
                    </StackPanel>
                    <CheckBox x:Name="GeoMirror" Content="Use the mission's lines instead" Margin="0,4,0,0" Click="ListMirror_Click" Tag="GEO_LINES"/>
                    <TextBlock Foreground="{DynamicResource Nebo.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Right-click the map: a point on the current line, after its selected point (25 points at most, steerpoints 31–55). Pick a point to continue its line."/>
                </StackPanel>
                <Grid x:Name="GeoEditor" DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock x:Name="GeoTitle" Grid.ColumnSpan="2" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="Line, note" VerticalAlignment="Center" Margin="0,0,8,3"/>
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,3">
                        <ComboBox x:Name="GeoLineBox" Width="70" SelectionChanged="GeoLineBox_Changed"/>
                        <TextBox x:Name="GeoNote" Margin="6,0,0,0" LostFocus="Geo_LostFocus"/>
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="Elevation" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="GeoElev" Width="70" LostFocus="Geo_LostFocus"/>
                        <TextBlock Text="ft" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="GeoList" FontFamily="Consolas" SelectionMode="Extended"
                         SelectionChanged="GeoList_SelectionChanged" KeyDown="StptList_KeyDown"/>
            </DockPanel>
        </TabItem>

        <!-- VIP / VRP -->
        <TabItem Header="VIP/VRP">
            <StackPanel Margin="6">
                <TextBlock Foreground="{DynamicResource Nebo.TextDim}" Margin="0,0,0,6" TextWrapping="Wrap"
                           Text="Pick the steerpoint, then Place a leg and right-click the map where its point goes (80 NM at most). The legs move with their steerpoint."/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="VIP steerpoint" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="VipNumber" Width="60" SelectionChanged="VipNumber_Changed" Tag="VIP"/>
                </StackPanel>
                <StackPanel x:Name="VipLegs" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="VRP steerpoint" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="VrpNumber" Width="60" SelectionChanged="VipNumber_Changed" Tag="VRP"/>
                </StackPanel>
                <StackPanel x:Name="VrpLegs"/>
            </StackPanel>
        </TabItem>

        <!-- COMM1 / COMM2 -->
        <TabItem Header="COMM">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="Comm1Mirror" Content="COMM1 from the mission" Margin="0,0,14,0" Click="CommMirror_Click" Tag="1"
                              ToolTip="DCS's 'mirror' option: the radio loads the mission's presets. Editing a channel turns it off."/>
                    <CheckBox x:Name="Comm2Mirror" Content="COMM2 from the mission" Click="CommMirror_Click" Tag="2"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Nebo.TextDim}" Margin="0,0,0,4" TextWrapping="Wrap"
                           Text="COMM1 UHF 225–399.975 AM. COMM2 VHF: FM 30–87.975, AM 116–155.975 (the modulation follows the band)."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="CommGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- CMDS -->
        <TabItem Header="CMDS">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Program" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmdsProgram" Width="80" SelectionChanged="CmdsProgram_Changed"/>
                    <Button Content="Apply" Padding="8,1" Margin="8,0,0,0" Click="CmdsApply_Click"/>
                    <TextBlock Text="Delay between programs" VerticalAlignment="Center" Margin="14,0,4,0"/>
                    <ComboBox x:Name="CmdsDelay" Width="70" SelectionChanged="CmdsDelay_Changed"/>
                </StackPanel>
                <Grid x:Name="ProgramGrid" DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Bingo: chaff" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="BingoChaff" Width="32"/>
                    <TextBlock Text="flares" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="BingoFlares" Width="32"/>
                    <TextBlock Text="other 1" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="BingoOther1" Width="32"/>
                    <TextBlock Text="other 2" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="BingoOther2" Width="32"/>
                    <CheckBox x:Name="BingoFdbk" Content="FDBK" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <CheckBox x:Name="BingoReqctr" Content="REQCTR" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <CheckBox x:Name="BingoBingo" Content="BINGO" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button Content="Apply" Padding="8,1" Margin="8,0,0,0" Click="BingoApply_Click"/>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Text="AUTO program and threshold of each threat" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <DataGrid x:Name="CmdsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Group" Binding="{Binding Category}" IsReadOnly="True" Width="60"/>
                        <DataGridTextColumn Header="Threat" Binding="{Binding Group}" IsReadOnly="True" Width="*"/>
                        <DataGridTemplateColumn Header="Program" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding Program, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Threshold" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Thresholds}" SelectedItem="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- RWR -->
        <TabItem Header="RWR">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Table" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="RwrTable" Width="80" SelectionChanged="RwrTable_Changed"
                              ToolTip="HIGH or LOW altitude threat table"/>
                    <TextBlock Foreground="{DynamicResource Nebo.TextDim}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"
                               Text="Type a priority to move an emitter there (1 = first); the rest close up."/>
                </StackPanel>
                <DataGrid x:Name="RwrGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority, UpdateSourceTrigger=LostFocus}" Width="60"/>
                        <DataGridTextColumn Header="Emitter" Binding="{Binding Group}" IsReadOnly="True" Width="*"/>
                        <DataGridCheckBoxColumn Header="Display" Binding="{Binding Display, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridCheckBoxColumn Header="Search" Binding="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridCheckBoxColumn Header="Unknown" Binding="{Binding Unknown, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ROE -->
        <TabItem Header="ROE">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="TypeSovereignty" Content="Type sovereignty" Margin="0,0,12,0" Click="RoeSettings_Click"/>
                    <CheckBox x:Name="Mode4Status" Content="Mode 4 status" Click="RoeSettings_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Friendly = my side" Padding="8,1" Click="Friendly_Click"
                            ToolTip="Your coalition's aircraft types (from NEBO's picture) FRIENDLY, types seen on the other side HOSTILE, the rest UNKNOWN. Also done for a new cartridge."/>
                    <TextBlock x:Name="FriendlyStatus" Foreground="{DynamicResource Nebo.TextDim}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <DataGrid x:Name="RoeGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Aircraft" Binding="{Binding Group}" IsReadOnly="True" Width="*"/>
                        <DataGridTemplateColumn Header="Sovereignty" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Sovereignty, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Symbol colours -->
        <TabItem Header="COLR">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Page" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ColrPage" Width="90" SelectionChanged="ColrPage_Changed"/>
                </StackPanel>
                <DataGrid x:Name="ColrGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Symbol" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                        <DataGridTemplateColumn Header="Colour" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
