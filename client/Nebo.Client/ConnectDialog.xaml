<Window x:Class="Nebo.Client.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="210"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Saved servers: pick one and Connect (double-click connects at once). -->
        <TextBlock Text="Servers" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ListBox x:Name="ServerList" Grid.Row="1" Grid.RowSpan="6" Height="210"
                 SelectionChanged="ServerList_SelectionChanged" MouseDoubleClick="ServerList_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="New" Width="64" Click="New_Click" ToolTip="A new server: fill in the fields on the right"/>
            <Button x:Name="DeleteButton" Content="Delete" Width="64" Margin="6,0,0,0" Click="Delete_Click" ToolTip="Forget the selected server"/>
        </StackPanel>

        <!-- The selected server's details (or a new one). -->
        <TextBlock Grid.Column="2" Text="Name" VerticalAlignment="Center" Margin="0,0,8,6" Grid.Row="1"/>
        <TextBox x:Name="NameBox" Grid.Column="3" Grid.Row="1" Margin="0,0,0,6"/>
        <TextBlock Grid.Column="2" Grid.Row="2" Text="Address" VerticalAlignment="Center" Margin="0,0,8,6"/>
        <TextBox x:Name="HostBox" Grid.Column="3" Grid.Row="2" Margin="0,0,0,6" ToolTip="The server's IP address or name"/>
        <TextBlock Grid.Column="2" Grid.Row="3" Text="Ports" VerticalAlignment="Center" Margin="0,0,8,6"/>
        <StackPanel Grid.Column="3" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBox x:Name="PortBox" Width="70" ToolTip="NEBO port (NEBO)"/>
            <TextBlock Text="SRS" VerticalAlignment="Center" Margin="10,0,6,0"/>
            <TextBox x:Name="SrsPortBox" Width="70" ToolTip="The SRS server's port (same address)"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Grid.Row="4" Text="Password" VerticalAlignment="Center" Margin="0,0,8,6"/>
        <Grid Grid.Column="3" Grid.Row="4" Margin="0,0,0,6">
            <PasswordBox x:Name="PasswordBox" PasswordChanged="Password_Changed"
                         ToolTip="The server's password. Kept encrypted for your Windows user; only a proof of it is sent, after the Discord check"/>
            <TextBlock x:Name="PasswordHint" Text="(saved)" Opacity="0.5" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <TextBlock Grid.Column="2" Grid.Row="5" Text="SRS EAM" VerticalAlignment="Center" Margin="0,0,8,6"/>
        <Grid Grid.Column="3" Grid.Row="5" Margin="0,0,0,6">
            <PasswordBox x:Name="EamBox" PasswordChanged="Password_Changed"
                         ToolTip="Your coalition's SRS External AWACS Mode password; empty = no SRS"/>
            <TextBlock x:Name="EamHint" Text="(saved)" Opacity="0.5" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="6" TextWrapping="Wrap" Width="260" HorizontalAlignment="Left" Opacity="0.7" FontSize="11"
                   Text="Servers with Discord login open an Authorize popup in your Discord app. You pick Blue or Red after logging in."/>

        <StackPanel Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <TextBlock x:Name="ErrorText" Foreground="Firebrick" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Connect" Width="80" IsDefault="True" Click="Connect_Click"/>
            <Button Content="Cancel" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
