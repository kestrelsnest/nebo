<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NeboDeck</AssemblyName>
    <Product>NEBO ATC/GCI</Product>
    <Company>Kestrel's Nest Community</Company>
    <!-- The NEBO version: same as kVersion in server/dll/src/nebo.cpp (server/package.ps1 checks). -->
    <Version>0.16.0</Version>
    <RootNamespace>Nebo.StreamDeck</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
